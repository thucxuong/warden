{
  "name": "warden",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --parallel",
    "test:unit": "bun test --parallel tests/unit",
    "test:ui": "playwright test -c tests/ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site-ui && tsc --noEmit -p site-ui/tsconfig.node.json && tsc --noEmit -p tests/ui",
    "check": "bun run typecheck && bun test",
    "validate": "claude plugin validate . --strict && claude plugin validate plugins/warden --strict",
    "site:build": "bun website/build.ts",
    "site:serve": "bun website/serve.ts",
    "ui:dev": "vite --config site-ui/vite.config.ts",
    "ui:dev:mock": "vite --config site-ui/vite.config.ts --mode mock",
    "ui:build": "vite build --config site-ui/vite.config.ts",
    "ui:check": "bun scripts/ui-check.ts"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "mermaid": "12.1.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tunnel-rat": "0.1.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wouter": "3.13.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
